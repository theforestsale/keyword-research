# Copy this file to .env and fill in values

# ============ AI PROVIDER ============
# Choose your AI backend (free options work without billing):
#   groq  = Groq free tier (no credit card). Needs GROQ_API_KEY from console.groq.com
#   openai = OpenAI (needs billing/credits)
AI_PROVIDER=groq

# --- For groq ---
# Get a free key at https://console.groq.com/keys
GROQ_API_KEY=
AI_MODEL=openai/gpt-oss-120b
AI_BASE_URL=https://api.groq.com/openai/v1

# --- For openai (unused if provider=groq) ---
# OPENAI_API_KEY=
# AI_MODEL=gpt-4o-mini
# AI_BASE_URL=

SECRET_KEY=change_this_to_a_random_secret
MAX_KEYWORDS=20
